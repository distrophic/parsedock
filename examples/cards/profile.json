{
  "schema_version": 1,
  "name": "example-cards",
  "source": {
    "type": "file",
    "path": "page.html"
  },
  "extraction": {
    "format": "html",
    "container": "article.card",
    "fields": [
      {
        "name": "title",
        "selector": "h2",
        "kind": "text",
        "required": true
      },
      {
        "name": "price",
        "selector": ".price",
        "kind": "text",
        "required": false
      },
      {
        "name": "url",
        "selector": "a",
        "kind": "attribute",
        "attribute": "href",
        "required": true
      }
    ]
  },
  "export": {
    "format": "jsonl",
    "path": "cards.jsonl",
    "mode": "create"
  }
}
